{
  "name": "@adhikarisaroj795/nepali-calendar-react",
  "version": "1.3.0",
  "description": "Nepali (Bikram Sambat) date picker and AD to BS / BS to AD date converter for React, plain HTML and Node.js",
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "postbuild": "node scripts/verify-build.js",
    "prepare": "npm run build",
    "clean": "rimraf dist node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "test": "npm run build && node test/run-timezones.js",
    "dev": "vite",
    "prebuild": "node scripts/build-data.js",
    "predev": "node scripts/build-data.js"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "jsdom": "^31.0.1",
    "preact": "^11.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "vite": "^8.3.8",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "nepali-date-picker",
    "nepali-datepicker",
    "nepali-calendar",
    "bikram-sambat",
    "bs-to-ad",
    "ad-to-bs",
    "nepali-date-converter",
    "react",
    "react-nepali-calendar",
    "nepali",
    "datepicker",
    "bs-date"
  ],
  "author": {
    "name": "Saroj Adhikari",
    "email": "adhikarisaroj291@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adhikarisaroj795/nepali-calender-react.git"
  },
  "bugs": {
    "url": "https://github.com/adhikarisaroj795/nepali-calender-react/issues"
  },
  "homepage": "https://github.com/adhikarisaroj795/nepali-calender-react#readme",
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "files": [
    "dist",
    "styles/nepalicalender.css",
    "index.d.ts",
    "convert.d.ts",
    "standalone.d.ts"
  ],
  "types": "index.d.ts",
  "unpkg": "dist/standalone.js",
  "jsdelivr": "dist/standalone.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./convert": {
      "types": "./convert.d.ts",
      "import": "./dist/convert.mjs",
      "require": "./dist/convert.js"
    },
    "./standalone": {
      "types": "./standalone.d.ts",
      "import": "./dist/standalone.mjs",
      "require": "./dist/standalone.js"
    },
    "./styles/*": "./styles/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
